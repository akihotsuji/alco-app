# ローカル用シークレットのひな形。コピーして .dev.vars を作る（.dev.vars はコミットしない）
# 置き場の正本は spec/secrets.md。値は `openssl rand -hex 32` で生成し、チャットや git に貼らない
BETTER_AUTH_SECRET=
# 省略時はリクエストの origin を使う。本番 URL を dev に書かない
# BETTER_AUTH_URL=
# 未設定なら実行時エラーのウェブフックは送らない。値はチャットに貼らない
# ALERT_WEBHOOK_URL=
# パスワードリセット（8-03）。未設定ならメールは送らない。値はチャットに貼らない
RESEND_API_KEY=
# Google OAuth（8-04）。未設定なら Google ログインは失敗する。値はチャットに貼らない
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Turnstile（8-05）。両方揃ったときだけ有効。サイトキーは公開値。シークレットはチャットに貼らない
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# EMAIL_FROM=酒のしおり <noreply@sake-shiori.com>
# 認識モデル。未設定なら wrangler.jsonc の vars（3機能とも gemini-3.5-flash-lite。gemini-3.7-flash / workers-ai-llama に戻せる）
# AI_RECOGNITION_PROFILE=gemini-3.5-flash-lite
# AI_LABEL_RECOGNITION_PROFILE=gemini-3.5-flash-lite
# AI_NOTE_RECOGNITION_PROFILE=gemini-3.5-flash-lite
# AI_GATEWAY_ID=default
# AI_GATEWAY_COLLECT_LOG=0
# AI_RECOGNIZE_DAILY_LIMIT=30
# 新規登録の一時停止（8-06）。秘密ではない。1 でメール登録と Google 新規を止める
# SIGNUPS_CLOSED=0
