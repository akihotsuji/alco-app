# ローカル用シークレットのひな形。コピーして .dev.vars を作る（.dev.vars はコミットしない）
# 置き場の正本は spec/secrets.md。値は `openssl rand -hex 32` で生成し、チャットや git に貼らない
BETTER_AUTH_SECRET=
# 省略時はリクエストの origin を使う。本番 URL を dev に書かない
# BETTER_AUTH_URL=
# 未設定なら実行時エラーのウェブフックは送らない。値はチャットに貼らない
# ALERT_WEBHOOK_URL=
# パスワードリセット（8-03）。未設定ならメールは送らない。値はチャットに貼らない
RESEND_API_KEY=
# EMAIL_FROM=酒のしおり <noreply@sake-shiori.com>
# 認識モデル。未設定なら wrangler.jsonc の vars（酒記録は gemini-3.7-flash）
# AI_RECOGNITION_PROFILE=gemini-3.7-flash
# AI_LABEL_RECOGNITION_PROFILE=workers-ai-llama
# AI_NOTE_RECOGNITION_PROFILE=workers-ai-llama
# AI_GATEWAY_ID=default
# AI_GATEWAY_COLLECT_LOG=0
# AI_RECOGNIZE_DAILY_LIMIT=30
