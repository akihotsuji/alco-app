{
  "$schema": "node_modules/wrangler/config-schema.json",
  // トップレベルは共通設定のみ。実リソースは env.dev / env.production に置く（無引数 deploy をどちらにも向けない）
  "name": "alco-app",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "assets": {
    // Vite プラグイン利用時はビルド出力が自動で繋がる。wrangler dev --env dev 用に directory も残す
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/*"]
  },
  "ai": {
    "binding": "AI"
  },
  // 名前付き env は明示しないと乗らないことがある。dev / production にも同じ値を書く
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "dev": {
      "name": "alco-app-dev",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "AI_RECOGNITION_PROFILE": "gemini-3.7-flash",
        "AI_LABEL_RECOGNITION_PROFILE": "workers-ai-llama",
        "AI_NOTE_RECOGNITION_PROFILE": "workers-ai-llama",
        "AI_GATEWAY_ID": "default",
        "AI_GATEWAY_COLLECT_LOG": "0",
        "EMAIL_FROM": "酒のしおり <noreply@sake-shiori.com>",
        "SIGNUPS_CLOSED": "0"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "alco-app-dev",
          "database_id": "2a585f35-d56d-4420-8d90-d29d5b30e6a1",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "alco-app-photos-dev"
        }
      ],
      "triggers": {
        "crons": ["0 18 * * *"]
      }
    },
    "production": {
      "name": "alco-app-prod",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "workers_dev": true,
      "vars": {
        "CANONICAL_ORIGIN": "https://sake-shiori.com",
        "AI_RECOGNITION_PROFILE": "gemini-3.7-flash",
        "AI_LABEL_RECOGNITION_PROFILE": "workers-ai-llama",
        "AI_NOTE_RECOGNITION_PROFILE": "workers-ai-llama",
        "AI_GATEWAY_ID": "default",
        "AI_GATEWAY_COLLECT_LOG": "0",
        "EMAIL_FROM": "酒のしおり <noreply@sake-shiori.com>",
        "SIGNUPS_CLOSED": "0"
      },
      "routes": [
        {
          "pattern": "sake-shiori.com",
          "custom_domain": true
        },
        {
          "pattern": "www.sake-shiori.com",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "alco-app-prod",
          "database_id": "b7dad946-90ff-4771-890f-540dd0ec8046",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "alco-app-photos-prod"
        }
      ],
      "triggers": {
        "crons": ["0 18 * * *"]
      }
    }
  }
}
